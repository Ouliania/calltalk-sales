{
  "manifest_version": 3,
  "name": "OkoCRM Mail Filter & Search | Call-Talk",
  "version": "1.2.0",
  "description": "Автоматическая фильтрация прогревочных писем Trigga и быстрый поиск по почте внутри OkoCRM",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.okocrm.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.okocrm.com/*"],
      "js": ["page-hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.okocrm.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Фильтр почты OkoCRM"
  }
}
