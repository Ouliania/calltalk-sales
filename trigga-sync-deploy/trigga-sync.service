[Unit]
Description=Trigga to OkoCRM Bi-directional Sync Daemon
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/trigga-okocrm-sync
ExecStart=/usr/bin/node /opt/trigga-okocrm-sync/trigga_okocrm_sync.js --daemon
Restart=always
RestartSec=10
StandardOutput=append:/opt/trigga-okocrm-sync/sync.log
StandardError=append:/opt/trigga-okocrm-sync/error.log
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
