# ==============================================================================
# Trigga <-> OkoCRM Sync Daemon Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TRIGGA API (Холодный email-аутрич)
# ------------------------------------------------------------------------------
# Токен авторизации из личного кабинета Trigga (Settings -> API)
TRIGGA_API_KEY=TRIGGA_API_KEY_PLACEHOLDER

# Базовый URL публичного API Trigga v1
TRIGGA_BASE_URL=https://api.trigga.ru/api/public/v1

# ------------------------------------------------------------------------------
# 2. OKOCRM API (MCP JSON-RPC 2.0)
# ------------------------------------------------------------------------------
# Токен доступа к MCP API OkoCRM (формат: <api_id>:<api_key>)
OKOCRM_API_TOKEN=OKOCRM_TOKEN_PLACEHOLDER

# URL коннектора MCP API OkoCRM
OKOCRM_MCP_URL=https://mcp.okocrm.com/crm

# ID воронки в OkoCRM (30895 = "B2B лидогенерация")
OKOCRM_PIPELINE_ID=30895

# Название входящего этапа воронки для новых ответов
OKOCRM_STAGE_NAME=Лид с Trigga

# Название источника сделки в OkoCRM (привязывается к выпадающему списку "Источник")
OKOCRM_SOURCE_NAME=Email

# Название причины отказа при закрытии сделки, по которой лид автоматически летит в ЧС Trigga
OKOCRM_LOSS_REASON_NAME=Trigga черный список

# ------------------------------------------------------------------------------
# 3. МЕНЕДЖЕРЫ (Поочередное распределение 50/50 Round-Robin)
# ------------------------------------------------------------------------------
# Андрей (andrey.s@calltalk.ru)
MANAGER_1_ID=28418

# Леонид (leonid.g@calltalk.ru)
MANAGER_2_ID=28419

# ------------------------------------------------------------------------------
# 4. РЕЖИМ ДЕМОНА
# ------------------------------------------------------------------------------
# Интервал опроса и синхронизации в минутах при запуске с флагом --daemon
SYNC_INTERVAL_MINUTES=5
